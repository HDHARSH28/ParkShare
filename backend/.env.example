# ParkShare Backend Environment Variables
NODE_ENV=development
PORT=5002

# MongoDB Connection String
# Local: mongodb://localhost:27017/parkshare
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/parkshare?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/parkshare

# JWT Authentication Secret
JWT_SECRET=parkshare_production_secret_key_change_me

# Allowed Frontend Origins for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,https://parkshare-app.vercel.app
